{
  "name": "@yadad/components",
  "version": "0.19.2",
  "description": "The yadad base component set: themeable, accessible field and layout components for the yadad renderer.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@yadad/source": "./registry/base.ts",
      "types": "./dist/registry/base.d.ts",
      "default": "./dist/registry/base.js"
    },
    "./board": {
      "@yadad/source": "./sets/base/board/v1/index.ts",
      "types": "./dist/sets/base/board/v1/index.d.ts",
      "default": "./dist/sets/base/board/v1/index.js"
    },
    "./boolean": {
      "@yadad/source": "./sets/base/boolean/v1/index.ts",
      "types": "./dist/sets/base/boolean/v1/index.d.ts",
      "default": "./dist/sets/base/boolean/v1/index.js"
    },
    "./button": {
      "@yadad/source": "./sets/base/button/v1/index.ts",
      "types": "./dist/sets/base/button/v1/index.d.ts",
      "default": "./dist/sets/base/button/v1/index.js"
    },
    "./calendar": {
      "@yadad/source": "./sets/base/calendar/v1/index.ts",
      "types": "./dist/sets/base/calendar/v1/index.d.ts",
      "default": "./dist/sets/base/calendar/v1/index.js"
    },
    "./count": {
      "@yadad/source": "./sets/base/count/v1/index.ts",
      "types": "./dist/sets/base/count/v1/index.d.ts",
      "default": "./dist/sets/base/count/v1/index.js"
    },
    "./date": {
      "@yadad/source": "./sets/base/date/v1/index.ts",
      "types": "./dist/sets/base/date/v1/index.d.ts",
      "default": "./dist/sets/base/date/v1/index.js"
    },
    "./datetime": {
      "@yadad/source": "./sets/base/datetime/v1/index.ts",
      "types": "./dist/sets/base/datetime/v1/index.d.ts",
      "default": "./dist/sets/base/datetime/v1/index.js"
    },
    "./dialog": {
      "@yadad/source": "./sets/base/dialog/v1/index.ts",
      "types": "./dist/sets/base/dialog/v1/index.d.ts",
      "default": "./dist/sets/base/dialog/v1/index.js"
    },
    "./error-summary": {
      "@yadad/source": "./sets/base/error-summary/v1/index.ts",
      "types": "./dist/sets/base/error-summary/v1/index.d.ts",
      "default": "./dist/sets/base/error-summary/v1/index.js"
    },
    "./field-frame": {
      "@yadad/source": "./sets/base/field-frame/v1/index.ts",
      "types": "./dist/sets/base/field-frame/v1/index.d.ts",
      "default": "./dist/sets/base/field-frame/v1/index.js"
    },
    "./number": {
      "@yadad/source": "./sets/base/number/v1/index.ts",
      "types": "./dist/sets/base/number/v1/index.d.ts",
      "default": "./dist/sets/base/number/v1/index.js"
    },
    "./pager": {
      "@yadad/source": "./sets/base/pager/v1/index.ts",
      "types": "./dist/sets/base/pager/v1/index.d.ts",
      "default": "./dist/sets/base/pager/v1/index.js"
    },
    "./panel": {
      "@yadad/source": "./sets/base/panel/v1/index.ts",
      "types": "./dist/sets/base/panel/v1/index.d.ts",
      "default": "./dist/sets/base/panel/v1/index.js"
    },
    "./reference": {
      "@yadad/source": "./sets/base/reference/v1/index.ts",
      "types": "./dist/sets/base/reference/v1/index.d.ts",
      "default": "./dist/sets/base/reference/v1/index.js"
    },
    "./section": {
      "@yadad/source": "./sets/base/section/v1/index.ts",
      "types": "./dist/sets/base/section/v1/index.d.ts",
      "default": "./dist/sets/base/section/v1/index.js"
    },
    "./select": {
      "@yadad/source": "./sets/base/select/v1/index.ts",
      "types": "./dist/sets/base/select/v1/index.d.ts",
      "default": "./dist/sets/base/select/v1/index.js"
    },
    "./table": {
      "@yadad/source": "./sets/base/table/v1/index.ts",
      "types": "./dist/sets/base/table/v1/index.d.ts",
      "default": "./dist/sets/base/table/v1/index.js"
    },
    "./tabs": {
      "@yadad/source": "./sets/base/tabs/v1/index.ts",
      "types": "./dist/sets/base/tabs/v1/index.d.ts",
      "default": "./dist/sets/base/tabs/v1/index.js"
    },
    "./text": {
      "@yadad/source": "./sets/base/text/v1/index.ts",
      "types": "./dist/sets/base/text/v1/index.d.ts",
      "default": "./dist/sets/base/text/v1/index.js"
    },
    "./styles.css": "./dist/yadad-components.css",
    "./styles/board.css": "./dist/styles/board.css",
    "./styles/boolean.css": "./dist/styles/boolean.css",
    "./styles/button.css": "./dist/styles/button.css",
    "./styles/calendar.css": "./dist/styles/calendar.css",
    "./styles/count.css": "./dist/styles/count.css",
    "./styles/date.css": "./dist/styles/date.css",
    "./styles/datetime.css": "./dist/styles/datetime.css",
    "./styles/dialog.css": "./dist/styles/dialog.css",
    "./styles/error-summary.css": "./dist/styles/error-summary.css",
    "./styles/field-frame.css": "./dist/styles/field-frame.css",
    "./styles/number.css": "./dist/styles/number.css",
    "./styles/pager.css": "./dist/styles/pager.css",
    "./styles/panel.css": "./dist/styles/panel.css",
    "./styles/reference.css": "./dist/styles/reference.css",
    "./styles/section.css": "./dist/styles/section.css",
    "./styles/select.css": "./dist/styles/select.css",
    "./styles/table.css": "./dist/styles/table.css",
    "./styles/tabs.css": "./dist/styles/tabs.css",
    "./styles/text.css": "./dist/styles/text.css"
  },
  "files": [
    "dist",
    "sets",
    "registry",
    "THEMING.md",
    "CHANGELOG.md",
    "!**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aggressive-stag/yadad-components.git"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changeset": "changeset",
    "gallery": "vite --config vite.gallery.config.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "theming:check": "node scripts/theming.ts check",
    "theming:docs": "node scripts/theming.ts write",
    "check:engine": "node scripts/check-engine.ts",
    "check:engine:install": "node scripts/check-engine.ts --install",
    "build:css": "node scripts/build-css.ts"
  },
  "peerDependencies": {
    "@yadad/core": "^0.10.0 || ^0.11.0 || ^0.12.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yadad/core": "link:../yadad/packages/core",
    "@yadad/renderer": "link:../yadad/packages/renderer",
    "@yadad/testing": "link:../yadad/testing",
    "@yadad/theme": "link:../yadad/packages/theme",
    "axe-core": "4.13.0",
    "jsdom": "~30.1.1",
    "playwright-core": "1.62.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
