{
  "name": "@yadad/components",
  "version": "0.1.2",
  "description": "The yadad base component set: themeable, accessible field and layout components for the yadad renderer.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@yadad/source": "./registry/base.ts",
      "types": "./dist/registry/base.d.ts",
      "default": "./dist/registry/base.js"
    },
    "./styles.css": "./dist/yadad-components.css"
  },
  "files": [
    "dist",
    "sets",
    "registry",
    "!**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aggressive-stag/yadad-components.git"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "build:css": "node scripts/build-css.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "@yadad/core": "^0.1.0 || ^0.2.0 || ^0.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yadad/core": "link:../yadad/packages/core",
    "@yadad/testing": "link:../yadad/testing",
    "jsdom": "~30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
