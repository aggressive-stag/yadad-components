{
  "name": "@yadad/components",
  "version": "0.16.0",
  "description": "The yadad base component set: themeable, accessible field and layout components for the yadad renderer.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@yadad/source": "./registry/base.ts",
      "types": "./dist/registry/base.d.ts",
      "default": "./dist/registry/base.js"
    },
    "./styles.css": "./dist/yadad-components.css"
  },
  "files": [
    "dist",
    "sets",
    "registry",
    "THEMING.md",
    "CHANGELOG.md",
    "!**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aggressive-stag/yadad-components.git"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changeset": "changeset",
    "gallery": "vite --config vite.gallery.config.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "theming:check": "node scripts/theming.ts check",
    "theming:docs": "node scripts/theming.ts write",
    "check:engine": "node scripts/check-engine.ts",
    "check:engine:install": "node scripts/check-engine.ts --install",
    "build:css": "node scripts/build-css.ts"
  },
  "peerDependencies": {
    "@yadad/core": "^0.10.0 || ^0.11.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yadad/core": "link:../yadad/packages/core",
    "@yadad/renderer": "link:../yadad/packages/renderer",
    "@yadad/testing": "link:../yadad/testing",
    "@yadad/theme": "link:../yadad/packages/theme",
    "jsdom": "~30.1.1",
    "playwright-core": "1.62.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
